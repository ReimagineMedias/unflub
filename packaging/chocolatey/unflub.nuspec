<?xml version="1.0" encoding="utf-8"?>
<!-- Pack and push by hand for now: docs/releasing.md, "Chocolatey". -->
<package xmlns="http://schemas.microsoft.com/packaging/2015/06/nuspec.xsd">
  <metadata>
    <id>unflub</id>
    <version>0.1.0</version>
    <packageSourceUrl>https://github.com/ReimagineMedias/unflub/tree/main/packaging/chocolatey</packageSourceUrl>
    <owners>Reimagine Media (RMGN)</owners>
    <title>unflub</title>
    <authors>Reimagine Media (RMGN)</authors>
    <projectUrl>https://unflub.rmgn.ca</projectUrl>
    <iconUrl>https://raw.githubusercontent.com/ReimagineMedias/unflub/main/app/src-tauri/icons/128x128.png</iconUrl>
    <copyright>© 2026 Matias Suxo</copyright>
    <licenseUrl>https://github.com/ReimagineMedias/unflub/blob/main/LICENSE</licenseUrl>
    <requireLicenseAcceptance>false</requireLicenseAcceptance>
    <projectSourceUrl>https://github.com/ReimagineMedias/unflub</projectSourceUrl>
    <bugTrackerUrl>https://github.com/ReimagineMedias/unflub/issues</bugTrackerUrl>
    <tags>unflub autocorrect spelling spell-checker typing typos productivity</tags>
    <summary>Phone-style autocorrect for every text field.</summary>
    <description><![CDATA[unflub fixes a typo the moment you finish the word, in any app: chat, browser, editor.
Press Backspace right after a fix to put your word back, and unflub remembers.

It lives in the tray and needs no account. Nothing you type leaves your computer.

This package runs the per-user installer, so unflub is installed for the account that runs
Chocolatey. Uninstalling removes start at login; settings stay in `%APPDATA%\ca.rmgn.unflub`.
]]></description>
    <releaseNotes>https://github.com/ReimagineMedias/unflub/releases/tag/v0.1.0</releaseNotes>
  </metadata>
  <files>
    <file src="tools\**" target="tools" />
  </files>
</package>
