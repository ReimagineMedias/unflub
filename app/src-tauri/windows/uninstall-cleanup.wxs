<?xml version="1.0" encoding="utf-8"?>
<!--
  Uninstall cleanup for the MSI (bundle > windows > wix > fragmentPaths in tauri.conf.json).

  The MSI installs per machine, but start at login is a per-user entry the app writes itself, so
  Windows Installer doesn't know about it. On a real uninstall (not an upgrade) this removes it for
  the user who uninstalls. The actions are deferred and impersonated, so reg.exe runs as that user
  rather than as LocalSystem, and they ignore failures (the entry may not exist).
  Other accounts that turned on start at login keep their HKCU entries, pointing at the removed
  unflub.exe: an uninstaller can't safely reach their HKCU (docs/releasing.md#uninstalling, issue 128).
  The MSI has no "delete app data" option: settings stay in %APPDATA%\ca.rmgn.unflub.
-->
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">
  <Fragment>
    <!-- Referenced from tauri.conf.json (componentGroupRefs) so the linker includes this fragment. -->
    <ComponentGroup Id="UnflubUninstallCleanup" />

    <CustomAction Id="UnflubRemoveLoginEntry" Directory="TARGETDIR" Execute="deferred" Impersonate="yes" Return="ignore"
      ExeCommand="&quot;[SystemFolder]reg.exe&quot; delete &quot;HKCU\Software\Microsoft\Windows\CurrentVersion\Run&quot; /v unflub /f" />
    <CustomAction Id="UnflubRemoveLoginSwitch" Directory="TARGETDIR" Execute="deferred" Impersonate="yes" Return="ignore"
      ExeCommand="&quot;[SystemFolder]reg.exe&quot; delete &quot;HKCU\Software\Microsoft\Windows\CurrentVersion\Explorer\StartupApproved\Run&quot; /v unflub /f" />

    <InstallExecuteSequence>
      <Custom Action="UnflubRemoveLoginEntry" Before="InstallFinalize">REMOVE="ALL" AND NOT UPGRADINGPRODUCTCODE</Custom>
      <Custom Action="UnflubRemoveLoginSwitch" After="UnflubRemoveLoginEntry">REMOVE="ALL" AND NOT UPGRADINGPRODUCTCODE</Custom>
    </InstallExecuteSequence>
  </Fragment>
</Wix>
