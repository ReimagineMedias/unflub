{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Settings window",
  "windows": ["settings"],
  "permissions": [
    "core:default",
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        { "url": "https://github.com/ReimagineMedias/*" },
        { "url": "https://github.com/sponsors/ReimagineMedias" },
        { "url": "https://unflub.rmgn.net/*" }
      ]
    }
  ]
}
