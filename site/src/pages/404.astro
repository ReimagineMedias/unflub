---
import Base from "../layouts/Base.astro";
import Pill from "../components/Pill.astro";
import "../styles/scenes.css";
---

<Base title="Page not found | unflub" description="This page does not exist. Head back to unflub, phone-style autocorrect for every app." noindex>
  <section class="nf wrap">
    <p class="line loose" aria-hidden="true">This <span class="fx lit">page<Pill from="pgae" to="page" /></span> isn't here.</p>
    <h1 class="chapter">That link took a typo.</h1>
    <p class="lead">The page you asked for does not exist, or it moved.</p>
    <div class="cta-row">
      <a class="btn" href="/">Go to the home page</a>
      <a class="btn btn-quiet" href="/download/">Download unflub</a>
    </div>
  </section>
</Base>

<style>
  .nf {
    display: grid;
    justify-items: center;
    text-align: center;
    gap: 24px;
    padding-block: clamp(96px, 16vw, 200px);
  }

  .line {
    font: 400 1.5rem/1.4 var(--ui);
    --pill-size: 14px;
    margin-bottom: 24px;
  }

  .cta-row {
    justify-content: center;
  }
</style>
