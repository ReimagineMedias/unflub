---
/** The unflub mark: a lowercase u and a thin rose caret. Inherits colour from the text. */
interface Props {
  class?: string;
}
const { class: className } = Astro.props;
---

<svg class={className} viewBox="0 0 64 64" aria-hidden="true" focusable="false">
  <path d="M14 18 V36 a10.5 10.5 0 0 0 21 0 V18" fill="none" stroke="currentColor" stroke-width="7.5" stroke-linecap="round"></path>
  <rect x="42" y="9" width="4.5" height="46" rx="2.25" fill="var(--accent)"></rect>
</svg>
