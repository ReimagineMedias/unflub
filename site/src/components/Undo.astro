---
import Window from "./Window.astro";
import Pill from "./Pill.astro";

const steps = [
  { title: "unflub fixes a word", text: "You type a name it doesn't know, and it changes it like any other typo." },
  { title: "You press Backspace", text: "Right after a fix, Backspace puts your word back instead of deleting a letter." },
  { title: "It remembers", text: "That word goes into Your words, and unflub leaves it alone from then on." },
];
---

<section id="undo" class="undo chapter-block" aria-labelledby="undo-title">
  <div class="wrap">
    <header class="section-head center">
      <h2 id="undo-title" class="chapter">Backspace means no.</h2>
      <p class="lead">Wrong fix? Press Backspace once. Your word comes back, and unflub learns it.</p>
    </header>

    <Window
      title="Notes"
      class="notes"
      data-undo
      label="A notes app. Ines is typed and changed to Ones. Backspace restores Ines, the capsule says undone, and Ines is added to Your words. Typed again, Ines is left alone."
    >
      <div class="doc">
        <p class="doc-title">Friday</p>
        <div class="field" data-a="Lunch with {Ines|Ones|undo} " data-b="on Friday? Ines found the place.">
          <span class="ink">Lunch with <span class="fx">Ines<Pill from="Ones" to="Ines" undone /></span> on Friday? Ines found the place.</span>
          <span class="pill" aria-hidden="true"></span>
        </div>
      </div>
      <div class="toast show" aria-hidden="true">
        <svg viewBox="0 0 16 16"><path d="m3.5 8.5 3 3 6-7"></path></svg>
        <span><b>Ines</b> added to Your words</span>
      </div>
    </Window>

    <ol class="steps" data-undo-steps>
      {
        steps.map((s, i) => (
          <li class:list={["step", i === 2 && "is-active"]}>
            <span class="n" aria-hidden="true">{i + 1}</span>
            <h3>{s.title}</h3>
            <p>{s.text}</p>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<script>
  import "../scripts/undo";
</script>

<style>
  .undo :global(.notes) {
    max-width: 880px;
    height: clamp(250px, 26vw, 300px);
    margin-inline: auto;
  }

  .doc {
    flex: 1;
    padding: 32px clamp(22px, 5vw, 64px);
  }

  .doc-title {
    font-size: 26px;
    font-weight: 700;
    letter-spacing: -0.01em;
    margin-bottom: 40px;
  }

  .doc .field {
    font-size: 19px;
    --pill-size: 13.5px;
  }

  .toast {
    position: absolute;
    right: 20px;
    bottom: 20px;
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 8px 14px 8px 10px;
    border-radius: 999px;
    background: var(--win);
    box-shadow:
      0 0 0 1px var(--win-line),
      0 8px 24px -8px rgba(0, 0, 0, 0.2);
    font-size: 13.5px;
    opacity: 0;
    translate: 0 6px;
    transition:
      opacity 0.3s ease,
      translate 0.4s var(--ease-out);
  }

  .toast.show {
    opacity: 1;
    translate: 0 0;
  }

  .toast svg {
    width: 16px;
    height: 16px;
    fill: none;
    stroke: var(--rose);
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .toast b {
    font-weight: 600;
  }

  .steps {
    list-style: none;
    margin: clamp(48px, 6vw, 72px) auto 0;
    padding: 0;
    max-width: 1040px;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: clamp(24px, 4vw, 56px);
  }

  .step {
    display: grid;
    gap: 8px;
    align-content: start;
    transition: opacity 0.4s ease;
  }

  :global(.undo.live) .step:not(.is-active) h3 {
    color: var(--muted);
  }

  .n {
    display: grid;
    place-items: center;
    width: 30px;
    height: 30px;
    margin-bottom: 6px;
    border-radius: 50%;
    box-shadow: inset 0 0 0 1.5px var(--line);
    font: 500 0.8125rem/1 var(--mono);
    color: var(--muted);
    transition: background-color 0.3s ease, color 0.3s ease, box-shadow 0.3s ease;
  }

  .step.is-active .n {
    background: var(--ink);
    color: var(--ground);
    box-shadow: none;
  }

  .step h3 {
    font-size: 1.25rem;
    letter-spacing: -0.025em;
  }

  .step p {
    color: var(--muted);
  }

  @media (max-width: 760px) {
    .steps {
      grid-template-columns: 1fr;
    }

    .doc .field {
      font-size: 17px;
      --pill-size: 12.5px;
    }

    .toast {
      left: 16px;
      right: auto;
    }
  }
</style>
