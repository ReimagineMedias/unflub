---
import { SITE } from "../data/site";

const statement =
  "Nothing you type leaves your computer. unflub counts how it's used, never what you write, and you can switch that off in one click.";
const words = statement.split(" ");

const facts = [
  { title: "Fixed on your computer", text: "Every correction is worked out locally. It works on a plane with Wi-Fi off." },
  {
    title: "Counts, not words",
    text: "Usage stats count things like fixes per day, settings used and speed. Crash reports have your text scrubbed out. Both are on by default, and one switch turns them off.",
  },
  { title: "A daily update check", text: "It sends the app version, your Windows version and a random ID that isn't tied to you." },
  {
    title: "Help improve corrections",
    text: "Off unless you turn it on. Shares typo and fix pairs like teh → the, for common dictionary words only, never names or numbers.",
  },
  { title: "Passwords skipped", text: "Password fields are ignored. Password managers and terminals are skipped by default." },
  { title: "Open source", text: "No account and no ads. Every line is on GitHub under the MIT licence.", href: SITE.repo },
];
---

<section id="privacy" class="privacy tone-deep chapter-block" aria-labelledby="privacy-title">
  <div class="wrap">
    <h2 id="privacy-title" class="chapter">Private by design.</h2>
    <p class="statement">
      {words.map((w) => <span class="w">{w} </span>)}
    </p>
    <p class="exception"><a href="/privacy/">See exactly what it sends</a></p>
    <ul class="facts">
      {
        facts.map((f) => (
          <li>
            <h3>{f.title}</h3>
            <p>
              {f.text}
              {f.href && (
                <>
                  {" "}
                  <a href={f.href}>Read the code</a>
                </>
              )}
            </p>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .privacy {
    padding-top: 0;
  }

  .privacy > .wrap {
    padding-top: clamp(96px, 14vw, 180px);
    border-top: 1px solid var(--line);
  }

  .statement {
    margin-top: 40px;
    max-width: 22em;
    font-size: clamp(1.75rem, 4.2vw, 3.5rem);
    line-height: 1.12;
    font-weight: 650;
    letter-spacing: -0.035em;
  }

  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      .w {
        animation: light linear both;
      }

      /* Separate rule so the timeline is not folded into the shorthand. */
      .statement .w {
        animation-timeline: view();
        animation-range: entry 60% cover 45%;
      }
    }
  }

  @keyframes light {
    from {
      opacity: 0.5;
    }
    to {
      opacity: 1;
    }
  }

  .exception {
    margin-top: 28px;
    max-width: 40em;
    font-size: clamp(1.0625rem, 1.5vw, 1.25rem);
    color: var(--muted);
  }

  .exception a {
    color: var(--ink);
    text-decoration-color: var(--accent);
    white-space: nowrap;
  }

  .facts {
    list-style: none;
    margin: clamp(64px, 9vw, 120px) 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 48px 40px;
  }

  .facts li {
    display: grid;
    gap: 8px;
    align-content: start;
  }

  .facts h3 {
    font-size: 1.125rem;
    letter-spacing: -0.02em;
  }

  .facts h3::before {
    content: "";
    display: block;
    width: 3px;
    height: 22px;
    margin-bottom: 16px;
    border-radius: 2px;
    background: var(--accent);
  }

  .facts p {
    color: var(--muted);
    font-size: 0.9375rem;
  }

  .facts a {
    color: var(--ink);
    text-decoration-color: var(--accent);
  }

  @media (max-width: 900px) {
    .facts {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 520px) {
    .facts {
      grid-template-columns: 1fr;
    }
  }
</style>
