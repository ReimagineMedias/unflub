---
import Window from "./Window.astro";
import Pill from "./Pill.astro";
import DownloadButton from "./DownloadButton.astro";
import DemoToggle from "./DemoToggle.astro";
import { SITE } from "../data/site";

const chats = [
  { name: "Friday dinner", line: "Maya: Table for three at 7", initials: "FD", active: true },
  { name: "Design review", line: "Notes are in the doc", initials: "DR" },
  { name: "Mom", line: "Call me when you land", initials: "M" },
  { name: "Running club", line: "Sunday, 8 am, same spot", initials: "RC" },
  { name: "Sam Okafor", line: "Sounds good!", initials: "SO" },
];
---

<section class="hero" aria-labelledby="hero-title">
  <div class="copy wrap">
    <h1 id="hero-title">
      <span class="kicker">Phone-style autocorrect for every app on your Windows PC</span>
      <span class="display slogan"><span>Type fast.</span> <span>Land it right.<i class="h1-caret" aria-hidden="true"></i></span></span>
    </h1>
    <p class="lead">
      unflub fixes a typo the moment you finish the word, system-wide: chat, email, the browser, AI prompt boxes. Built for Windows
      11 and 10.
    </p>
    <div class="cta-row">
      <DownloadButton />
      <a class="btn btn-quiet" href={SITE.repo}>View on GitHub</a>
    </div>
    <p class="small fine">Free and open source, with no paid tier. Mac and Linux next.</p>
  </div>

  <div class="wrap">
    <div class="studio">
      <DemoToggle name="hero" class="studio-toggle" />
      <div class="object" aria-hidden="true">
        <span class="studio-pill"><s>teh</s><span class="arr">→</span><b>the</b><kbd>⌫ undo</kbd></span>
        <span class="contact"></span>
      </div>
      <div class="studio-chat">
        <Window
          title="Chat"
          class="chat"
          label="A chat app. A message is typed with typos, and unflub fixes each one as the word ends: teh becomes the, with a small capsule above the word offering undo."
          data-hero
        >
          <aside class="side">
            <div class="search">Search</div>
            <ul>
              {
                chats.map((c) => (
                  <li class:list={{ active: c.active }}>
                    <span class="av">{c.initials}</span>
                    <span class="meta">
                      <b>{c.name}</b>
                      <span>{c.line}</span>
                    </span>
                  </li>
                ))
              }
            </ul>
          </aside>
          <div class="main">
            <div class="head">
              <b>Friday dinner</b>
              <span>Maya, Theo and you</span>
            </div>
            <div class="log">
              <div class="track">
                <div class="msg them"><span class="av">M</span><p><span class="who">Maya</span>Dinner Friday? I found a dumpling place downtown.</p></div>
                <div class="msg me"><p>Yes please.</p></div>
                <div class="msg them"><span class="av">M</span><p><span class="who">Maya</span>Table for three at 7. Who's in?</p></div>
                <div class="msg them"><span class="av">T</span><p><span class="who">Theo</span>In. Starving already.</p></div>
              </div>
            </div>
            <div class="composer">
              <div class="field" data-placeholder="Message Friday dinner">
                <span class="ink">Running late, <span class="fx lit">the<Pill from="teh" to="the" /></span> <span class="caret"></span></span>
                <span class="pill" aria-hidden="true"></span>
              </div>
              <span class="send" aria-hidden="true">
                <svg viewBox="0 0 20 20"><path d="M3.5 10h12m0 0-5-5m5 5-5 5" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"></path></svg>
              </span>
            </div>
          </div>
        </Window>
      </div>
    </div>
  </div>
</section>

<script>
  import "../scripts/hero";
</script>

<style>
  .hero {
    padding-top: calc(var(--header) + clamp(8px, 2.4vh, 40px));
    overflow: clip;
  }

  .copy {
    display: grid;
    justify-items: center;
    text-align: center;
    gap: clamp(12px, 2vh, 22px);
  }

  /* Short laptop screens: a slightly smaller slogan, so the chat's message box is on the first screen. */
  .slogan {
    font-size: clamp(2.6rem, min(6.2vw, 8.6vh), 8rem);
  }

  h1 {
    display: grid;
    gap: clamp(10px, 1.8vh, 16px);
  }

  .kicker {
    font-size: clamp(1rem, min(1.4vw, 2.4vh), 1.25rem);
    font-weight: 650;
    letter-spacing: -0.01em;
    color: var(--muted);
  }

  .slogan > span {
    display: block;
  }

  .h1-caret {
    display: inline-block;
    width: 0.06em;
    height: 0.82em;
    margin-left: 0.08em;
    vertical-align: -0.06em;
    border-radius: 0.03em;
    background: var(--accent);
  }

  @media (prefers-reduced-motion: no-preference) {
    .h1-caret {
      animation: h1-blink 1.1s steps(1) infinite;
    }
  }

  @keyframes h1-blink {
    50% {
      opacity: 0;
    }
  }

  .copy .lead {
    max-width: 34em;
  }

  .cta-row {
    justify-content: center;
  }

  .fine {
    margin-top: -4px;
  }

  /* A studio card: key light from above, falling off toward the floor. The capsule floats over the window. */
  .studio {
    position: relative;
    margin-top: clamp(18px, 3vh, 44px);
    padding: clamp(30px, 4.6vh, 64px) clamp(14px, 5vw, 64px) 0;
    border-radius: clamp(24px, 3vw, 40px);
    overflow: clip;
    background:
      radial-gradient(70% 55% at 50% 0%, #ffffff 0%, rgba(255, 255, 255, 0) 70%),
      linear-gradient(var(--surface), #eee9e7);
  }

  .studio :global(.studio-toggle) {
    position: absolute;
    z-index: 3;
    top: 16px;
    right: 16px;
  }

  .object {
    position: absolute;
    z-index: 2;
    top: clamp(6px, 1vh, 16px);
    left: 50%;
    translate: -50% 0;
    display: grid;
    justify-items: center;
  }

  .object .studio-pill {
    font-size: clamp(15px, min(1.8vw, 2.9vh), 26px);
  }

  .contact {
    width: 110%;
    height: 22px;
    margin-top: 10px;
    border-radius: 50%;
    background: radial-gradient(closest-side, rgba(45, 25, 22, 0.26), rgba(45, 25, 22, 0));
  }

  .studio-chat {
    max-width: 1040px;
    margin-inline: auto;
  }

  @media (min-width: 2000px) {
    .studio-chat {
      max-width: 1360px;
    }
  }

  .studio-chat :global(.chat) {
    /* Whatever the first screen has left after the copy, so the message box shows; roomier on tall screens. */
    height: clamp(270px, 56svh - 142px, 720px);
    border-bottom-left-radius: 0;
    border-bottom-right-radius: 0;
    box-shadow:
      0 0 0 1px rgba(45, 25, 22, 0.06),
      0 -2px 30px -8px rgba(45, 25, 22, 0.12),
      0 30px 60px -20px rgba(45, 25, 22, 0.25);
  }

  /* The scene reads at share size: slightly larger than a real chat app. */
  .track :global(.msg p) {
    font-size: 16px;
  }

  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      .object .studio-pill {
        animation: lift linear both;
      }

      .contact {
        animation: shadow-lift linear both;
      }

      .studio-chat {
        transform-origin: 50% 100%;
        animation: rise linear both;
      }

      /* Separate rule so the timeline is not folded into the shorthand. */
      .studio .object .studio-pill,
      .studio .object .contact,
      .studio .studio-chat {
        animation-timeline: scroll(root);
        animation-range: 0px 520px;
      }
    }
  }

  @keyframes lift {
    to {
      transform: translateY(-24px) scale(1.06);
    }
  }

  @keyframes shadow-lift {
    to {
      transform: scale(0.78);
      opacity: 0.45;
    }
  }

  /* Scale from the floor of the card, never slide below it, so the message box is never clipped. */
  @keyframes rise {
    from {
      transform: scale(0.97);
    }
    to {
      transform: none;
    }
  }

  .side {
    width: 264px;
    flex: none;
    padding: 14px 10px;
    background: var(--win-side);
    border-right: 1px solid var(--win-line);
  }

  .search {
    padding: 7px 12px;
    margin: 0 4px 12px;
    border-radius: 8px;
    background: var(--win-field);
    color: var(--win-muted);
    font-size: 13px;
  }

  .side ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 2px;
  }

  .side li {
    display: flex;
    gap: 10px;
    align-items: center;
    padding: 9px 10px;
    border-radius: 9px;
  }

  .side li.active {
    background: color-mix(in srgb, var(--win-ink) 7%, transparent);
  }

  .meta {
    display: grid;
    min-width: 0;
    line-height: 1.3;
  }

  .meta b {
    font-weight: 600;
    font-size: 14px;
  }

  .meta span {
    font-size: 12.5px;
    color: var(--win-muted);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .av {
    display: grid;
    place-items: center;
    width: 34px;
    height: 34px;
    flex: none;
    border-radius: 50%;
    background: color-mix(in srgb, var(--win-ink) 10%, transparent);
    color: var(--win-muted);
    font-size: 12px;
    font-weight: 600;
  }

  .main {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
  }

  .head {
    display: flex;
    align-items: baseline;
    gap: 10px;
    padding: 14px 22px;
    border-bottom: 1px solid var(--win-line);
  }

  .head b {
    font-weight: 600;
  }

  .head span {
    font-size: 13px;
    color: var(--win-muted);
  }

  .log {
    position: relative;
    flex: 1;
    min-height: 0;
    overflow: hidden;
  }

  .track {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding: 18px 22px 8px;
  }

  .track :global(.msg) {
    display: flex;
    align-items: flex-end;
    gap: 10px;
    max-width: 78%;
  }

  .track :global(.msg p) {
    padding: 9px 14px;
    border-radius: 18px;
    background: var(--win-them);
    border-bottom-left-radius: 6px;
  }

  /* Bubbles added by the script carry no scope attribute, so these rules are global to the track. */
  .track :global(.msg .av) {
    display: grid;
    place-items: center;
    flex: none;
    width: 28px;
    height: 28px;
    border-radius: 50%;
    background: color-mix(in srgb, var(--win-ink) 10%, transparent);
    color: var(--win-muted);
    font-size: 11px;
    font-weight: 600;
  }

  .track :global(.who) {
    display: block;
    font-size: 12px;
    font-weight: 600;
    color: var(--win-muted);
  }

  .track :global(.msg.me) {
    align-self: flex-end;
  }

  .track :global(.msg.me p) {
    background: var(--win-me);
    color: var(--win-me-ink);
    border-radius: 18px;
    border-bottom-right-radius: 6px;
  }

  .composer {
    display: flex;
    align-items: center;
    gap: 10px;
    margin: 10px 18px 18px;
    padding: 12px 12px 12px 18px;
    border-radius: 14px;
    background: var(--win-field);
    box-shadow: inset 0 0 0 1px var(--win-line);
  }

  .composer .field {
    flex: 1;
    min-width: 0;
    font-size: 18px;
    --pill-size: 15px;
  }

  .send {
    display: grid;
    place-items: center;
    width: 34px;
    height: 34px;
    flex: none;
    border-radius: 50%;
    background: var(--win-me);
    color: var(--win-me-ink);
  }

  .send svg {
    width: 18px;
    height: 18px;
  }

  @media (max-width: 760px) {
    .studio-chat :global(.chat) {
      height: 440px;
    }

    .side {
      display: none;
    }

    .head {
      padding: 12px 16px;
    }

    .track {
      padding-inline: 14px;
    }

    .track :global(.msg) {
      max-width: 90%;
    }

    .composer {
      margin: 8px 10px 12px;
      padding-left: 14px;
    }

    .composer .field {
      font-size: 15px;
      --pill-size: 12px;
      /* Two lines reserved, so a wrapping message never moves the chat above it. */
      min-height: 3em;
    }

    .composer {
      align-items: flex-start;
    }
  }
</style>
