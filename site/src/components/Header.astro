---
import Wordmark from "./Wordmark.astro";
import DownloadButton from "./DownloadButton.astro";

const links = [
  { href: "/#everywhere", label: "Everywhere" },
  { href: "/#undo", label: "Undo" },
  { href: "/#privacy", label: "Privacy" },
  { href: "/#settings", label: "Settings" },
  { href: "/#compare", label: "Compare" },
  { href: "/#faq", label: "FAQ" },
];
---

<header class="site-header">
  <div class="bar">
    <a class="home" href="/" aria-label="unflub home"><Wordmark /></a>
    <nav aria-label="Main">
      <ul>
        {links.map((l) => <li><a href={l.href}>{l.label}</a></li>)}
      </ul>
    </nav>
    <DownloadButton size="small" short />
  </div>
</header>

<script>
  // Watch an 8px strip at the top of the page: while it is visible, the header stays clear.
  const header = document.querySelector<HTMLElement>(".site-header");
  if (header) {
    const strip = document.createElement("div");
    strip.setAttribute("aria-hidden", "true");
    strip.style.cssText = "position:absolute;top:0;left:0;width:1px;height:8px;pointer-events:none;visibility:hidden";
    document.body.prepend(strip);
    new IntersectionObserver(([entry]) => header.classList.toggle("at-top", entry?.isIntersecting ?? false)).observe(strip);
  }
</script>

<style>
  /* Frosted once the page scrolls; transparent at the very top (the script adds .at-top).
     Without the script it stays frosted, which looks the same at the top. */
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    height: var(--header);
    background: color-mix(in srgb, var(--ground) 72%, transparent);
    backdrop-filter: blur(20px) saturate(1.4);
    -webkit-backdrop-filter: blur(20px) saturate(1.4);
    box-shadow: 0 1px 0 var(--line);
    transition:
      background-color 0.2s ease,
      backdrop-filter 0.2s ease,
      -webkit-backdrop-filter 0.2s ease,
      box-shadow 0.2s ease;
  }

  .site-header.at-top {
    background: transparent;
    backdrop-filter: blur(0px) saturate(1);
    -webkit-backdrop-filter: blur(0px) saturate(1);
    box-shadow: 0 1px 0 transparent;
  }

  @media (prefers-reduced-transparency: reduce) {
    .site-header {
      background: var(--ground);
      backdrop-filter: none;
      -webkit-backdrop-filter: none;
    }
  }

  .bar {
    width: var(--page);
    height: 100%;
    margin-inline: auto;
    display: flex;
    align-items: center;
    gap: 24px;
  }

  .home {
    text-decoration: none;
    border-radius: 8px;
    padding: 6px 0;
  }

  nav {
    margin-left: auto;
  }

  ul {
    display: flex;
    gap: 4px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  nav a {
    display: block;
    padding: 8px 12px;
    border-radius: 999px;
    font-size: 0.875rem;
    font-weight: 560;
    color: var(--muted);
    text-decoration: none;
    transition: color 0.15s ease, background-color 0.15s ease;
  }

  nav a:hover {
    color: var(--ink);
    background: var(--hover);
  }

  @media (max-width: 900px) {
    nav {
      display: none;
    }

    .bar :global(.dl) {
      margin-left: auto;
    }
  }
</style>
