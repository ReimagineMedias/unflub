---
import Wordmark from "./Wordmark.astro";
import { SITE } from "../data/site";

const links = [
  { href: "/#everywhere", label: "Everywhere" },
  { href: "/#undo", label: "Undo" },
  { href: "/#privacy", label: "Privacy" },
  { href: "/#settings", label: "Settings" },
  { href: "/#faq", label: "FAQ" },
];
---

<header class="site-header">
  <nav class="pill-nav day" aria-label="Main">
    <a class="home" href="/" aria-label="unflub home"><Wordmark /></a>
    <ul>
      {links.map((l) => <li><a href={l.href}>{l.label}</a></li>)}
    </ul>
    <a class="nav-dl" href={SITE.download} data-dl="short"><span data-dl-label>Download</span></a>
  </nav>
  <!-- The night copy sits exactly on top and fades in over the home page's night stretch. It is inert, so clicks
       and focus always reach the real nav underneath. -->
  <div class="pill-nav night" aria-hidden="true" inert>
    <span class="home"><Wordmark /></span>
    <ul>{links.map((l) => <li><span>{l.label}</span></li>)}</ul>
    <span class="nav-dl">Download</span>
  </div>
</header>

<script>
  import "../scripts/os";
  import "../scripts/night";
</script>

<style>
  .site-header {
    position: fixed;
    top: 14px;
    left: 0;
    right: 0;
    z-index: 50;
    display: grid;
    justify-content: center;
    pointer-events: none;
  }

  .pill-nav {
    grid-area: 1 / 1;
    display: flex;
    align-items: center;
    gap: 2px;
    height: 52px;
    padding: 0 6px 0 18px;
    border-radius: 999px;
    pointer-events: auto;
  }

  .day {
    background: var(--espresso);
    color: var(--paper);
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.06),
      0 10px 30px -12px rgba(45, 25, 22, 0.55);
  }

  .day :global(.wordmark-mark rect) {
    fill: var(--rose-on-dark);
  }

  .night {
    pointer-events: none;
    background: var(--paper);
    color: var(--espresso);
    box-shadow: 0 10px 40px -12px rgba(0, 0, 0, 0.8);
    opacity: 0;
    transition: opacity 0.6s ease;
  }

  :global(html.is-night) .night {
    opacity: 1;
  }

  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      .night {
        transition: none;
        animation:
          nightfall linear both,
          daybreak linear forwards;
      }

      /* Separate rule so the timeline is not folded into the shorthand. Ranges match .dusk in global.css. */
      .site-header .night {
        animation-timeline: --story, --story;
        animation-range:
          entry 15% entry 55%,
          exit 25% exit 60%;
      }
    }
  }

  .home {
    display: flex;
    margin-right: 14px;
    padding: 6px 0;
    border-radius: 8px;
    color: inherit;
    text-decoration: none;
  }

  ul {
    display: flex;
    gap: 2px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  ul a,
  ul span {
    display: block;
    padding: 8px 12px;
    border-radius: 999px;
    font-size: 0.875rem;
    font-weight: 560;
    color: inherit;
    text-decoration: none;
  }

  .day ul a {
    color: #d9c3bd;
    transition:
      color 0.15s ease,
      background-color 0.15s ease;
  }

  .day ul a:hover {
    color: var(--paper);
    background: rgba(242, 230, 227, 0.08);
  }

  .night ul span {
    color: var(--brown);
  }

  .nav-dl {
    display: inline-flex;
    align-items: center;
    min-height: 40px;
    margin-left: 10px;
    padding: 0 18px;
    border-radius: 999px;
    font-size: 0.875rem;
    font-weight: 680;
    text-decoration: none;
  }

  .day .nav-dl {
    background: var(--paper);
    color: var(--espresso);
  }

  .night .nav-dl {
    background: var(--espresso);
    color: var(--paper);
  }

  .day :focus-visible {
    outline-color: var(--rose-on-dark);
  }

  @media (max-width: 820px) {
    ul {
      display: none;
    }
  }
</style>
