---
import Wordmark from "./Wordmark.astro";
import DownloadButton from "./DownloadButton.astro";

const links = [
  { href: "/#everywhere", label: "Everywhere" },
  { href: "/#undo", label: "Undo" },
  { href: "/#privacy", label: "Privacy" },
  { href: "/#settings", label: "Settings" },
  { href: "/#compare", label: "Compare" },
  { href: "/#faq", label: "FAQ" },
];
---

<header class="site-header">
  <div class="bar">
    <a class="home" href="/" aria-label="unflub home"><Wordmark /></a>
    <nav aria-label="Main">
      <ul>
        {links.map((l) => <li><a href={l.href}>{l.label}</a></li>)}
      </ul>
    </nav>
    <DownloadButton size="small" short />
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    height: var(--header);
    background: color-mix(in srgb, var(--ground) 92%, transparent);
    backdrop-filter: saturate(1.6) blur(18px);
    -webkit-backdrop-filter: saturate(1.6) blur(18px);
    box-shadow: 0 1px 0 transparent;
  }

  @supports (animation-timeline: scroll()) {
    .site-header {
      animation: header-edge linear both;
      animation-timeline: scroll();
      animation-range: 0 120px;
    }
  }

  @keyframes header-edge {
    to {
      box-shadow: 0 1px 0 var(--line);
    }
  }

  .bar {
    width: var(--page);
    height: 100%;
    margin-inline: auto;
    display: flex;
    align-items: center;
    gap: 24px;
  }

  .home {
    text-decoration: none;
    border-radius: 8px;
    padding: 6px 0;
  }

  nav {
    margin-left: auto;
  }

  ul {
    display: flex;
    gap: 4px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  nav a {
    display: block;
    padding: 8px 12px;
    border-radius: 999px;
    font-size: 0.875rem;
    font-weight: 560;
    color: var(--muted);
    text-decoration: none;
    transition: color 0.15s ease, background-color 0.15s ease;
  }

  nav a:hover {
    color: var(--ink);
    background: var(--hover);
  }

  @media (max-width: 900px) {
    nav {
      display: none;
    }

    .bar :global(.dl) {
      margin-left: auto;
    }
  }
</style>
